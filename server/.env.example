# Copy to .env and fill in. Generate each key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SERVER_HMAC_KEY=
SERVER_AES_KEY=
SERVER_SESSION_SECRET=

# Deliberately NOT 3000 — the separate `digdir-wallet-messaging-backend`
# prototype already defaults to that port. Don't run both on the same port.
PORT=3001
DB_PATH=./inbox.sqlite

# Universal Link domain the app opens for Request by Reference
# (`/keybinding/request-object/:state`). Needs a real hosted
# apple-app-site-association file in production; http://localhost:3001
# works for local testing since the fetcher allows http as a dev fallback.
UNIVERSAL_LINK_BASE=http://localhost:3001

# APNs — merged in from the standalone `digdir-wallet-messaging-backend`
# prototype. Values come from the .p8 key created in Apple Developer >
# Certificates, Identifiers & Profiles > Keys.
APNS_KEY_PATH=./secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=net.eidas2sandkasse.demo-lommebok.dev

# "development" while testing via Xcode/TestFlight with a dev-signed build,
# "production" once the app is signed for App Store distribution.
APNS_ENVIRONMENT=development
